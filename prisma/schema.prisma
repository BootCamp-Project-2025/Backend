generator develop {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

generator production {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  moduleFormat  = "cjs"
  generatedFileExtension  = "ts"
  importFilExtension  = "ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course{
  id      String      @id @default(uuid())
  name   String   @unique
  field String
  requirements String
  time Int
  description    String
  language String   @default("")
  category String   @default("")
  subCategory String   @default("")
  imgSrc String
  published Boolean @default(false)
  modules Module[]
  userId String
  user    User   @relation("UserCourse", fields: [userId], references: [id])
  Enrollment Enrollment[]
}

model Module{
  id      String      @id @default(uuid())
  position Decimal
  author   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  title   String
  lessons Lesson[]
  quizzes Quiz[]
}

model Lesson{
  id      String      @id @default(uuid())
  position Decimal
  author   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  description String
  resources Resource[]
  videoUrls String[]
  moduleId String
  title   String
  
}

model Resource{
  id      String      @id @default(uuid())
  author   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name   String 
  url   String   
  lessonId String
}

model Quiz{
  id      String      @id @default(uuid())
  author   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name   String 
  url   String   
  moduleId String
}

model SampleData {
  id String @id @default(uuid())
  content String
}

enum UserRole {
  CLIENT
  FREELANCER
}

model User {
  id                 String      @id @default(uuid())
  userName           String      @default("")
  userEmail          String      @unique
  roles              UserRole[]  @default([CLIENT])
  createdAt          DateTime    @default(now())
  profilePicture     String?
  freelancerProfile  Freelancer? @relation("UserFreelancer")
  clientProfile      Client?     @relation("UserClient")

  lastSeen         DateTime  @default(now())
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  chats            Chat[]    @relation("UserChats")
  Enrollment         Enrollment[]

  proposals          Proposal[]
  requests           Request[]   
  Course             Course[]    @relation("UserCourse")
}

model Freelancer {
  id      String @id @default(uuid())
  userId  String @unique 
  user    User   @relation("UserFreelancer", fields: [userId], references: [id] , onDelete: Cascade)
  about          String          @default("")
  skills         Skill[]
  languages      Language[]
  education      Education[]
  experience     Experience[]
  certifications Certification[]
}

model Client {
  id      String @id @default(uuid())
  userId  String @unique
  dateOfBirth   DateTime?
  country   String @default("")
  phoneNumber   String @default("")
  city  String @default("")
  gender String @default("")
  user    User   @relation("UserClient", fields: [userId], references: [id] , onDelete: Cascade)
  socialLink SocialLink[]
}

enum SocialPlatform {
  FACEBOOK
  YOUTUBE
  LINKEDIN
  INSTAGRAM
}

model SocialLink {
  id           String     @id @default(uuid())
  platform     SocialPlatform
  url          String     @default("")
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum SkillLevel {
  beginner
  intermediate
  advanced
}
model Skill {
  id           String     @id @default(uuid())
  name         String     @default("")
  level        SkillLevel @default(beginner)
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Language {
  id           String     @id @default(uuid())
  name         String     @default("")
  level        String     @default("")
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Certification {
  id            String     @id @default(uuid())
  certification String     @default("")
  institution   String     @default("")
  year          DateTime   @default(now())
  freelancerId  String
  freelancer    Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Education {
  id           String     @id @default(uuid())
  career       String     @default("")
  university   String     @default("")
  startDate    DateTime   @default(now())
  endDate      DateTime   @default(now())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Experience {
  id           String     @id @default(uuid())
  position     String     @default("")
  employer     String     @default("")
  country      String     @default("")
  description  String     @default("")
  startDate    DateTime   @default(now())
  endDate      DateTime   @default(now())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

enum MessageType {
  TEXT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id         String        @id @default(uuid())
  content    String
  type       MessageType
  timestamp  DateTime      @db.Timestamptz()
  status     MessageStatus @default(DELIVERED)
  senderId   String
  chatId     String
  sender     User          @relation("SentMessages", fields: [senderId], references: [id])
  receivers  User[]        @relation("ReceivedMessages")
  chat       Chat          @relation(fields: [chatId], references: [id])
}

model Chat {
  id           String     @id @default(uuid())
  name         String     @default("")
  createdAt    DateTime   @default(now())
  messages     Message[]
  participants User[]     @relation("UserChats")
  status   ChatStatus @default(ACTIVE)
}

enum ChatStatus {
    ACTIVE
    CLOSED
}

enum RequestStatus {
  PENDING
  AVAILABLE
  ACCEPTED
  REJECTED
}

enum RequestLanguage {
  EN
  ES
}

model Request {
  id             String           @id @default(uuid())
  userId         String
  title          String
  description    String
  language       String
  category       String
  subcategory    String
  status         RequestStatus    @default(PENDING)
  createdAt      DateTime         @default(now())
  estimation     Int
  edited         Boolean          @default(false)
  updatedAt      DateTime         @updatedAt

  proposals      Proposal[]
  user           User             @relation(fields: [userId], references: [id])
}

model Proposal {
  id             String      @id @default(uuid())
  requestId      String
  userId         String
  price          Int
  estimatedTime  Int
  message        String
  createdAt      DateTime    @default(now())
  request        Request     @relation(fields: [requestId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  CANCELED
}

model Enrollment {
  id          String     @id @default(uuid())
  userId       String
  courseId     String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  status       EnrollmentStatus @default(ENROLLED)
}
