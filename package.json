{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend of the crowdsourcing project.",
  "homepage": "https://github.com/BootCamp-Project-2025/Backend#readme",
  "bugs": {
    "url": "https://github.com/BootCamp-Project-2025/Backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BootCamp-Project-2025/Backend.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "app.js",
  "_moduleAliases": {
    "@": "src/"
  },
  "scripts": {
    "dev": "ts-node-dev -r module-alias/register --respawn --transpile-only src/main.ts",
    "build": "tsup src/main.ts --out-dir dist --format cjs --dts",
    "lint": "eslint .",
    "start": "node ./dist/main.js",
    "test": "jest --config jest.config.ts",
    "coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db": "npx prisma migrate dev && npx prisma generate --generator=develop",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate --generator=production"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "module-alias": "^2.2.3",
    "prisma": "^6.8.2",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
