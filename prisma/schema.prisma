generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course{
   id      String      @id @default(uuid())
  name   String   @unique
  field String
  requirements String
  time Int
  description    String
  modules Module[]
}

model Module{
  id      String      @id @default(uuid())
  author   Course @relation(fields: [CourseId], references: [id])
  CourseId String
  name   String   @unique
}