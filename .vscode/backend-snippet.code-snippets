      "import { StatusCodes } from \"http-status-codes\";",
      "",
      "interface ${1:Name}Props {",
      "  value: ${2:Type};",
      "}",
      "",
      "export class ${1:Name} extends ValueObject<${1:Name}Props> {",
      "  get value(): ${2:Type} {",
      "    return this.props.value;",
      "  }",
      "",
      "  private constructor(props: ${1:Name}Props) {",
      "    super(props);",
      "  }",
      "",
      "  private static isValid(value: ${2:Type}): boolean {",
      "    // TODO: Add validation logic here",
      "    return true;",
      "  }",
      "",
      "  public static create(value: ${2:Type}): ${1:Name} {",
      "    if (!value) {",
      "      throw new ApiError(StatusCodes.BAD_REQUEST, \"${1:Name} is required\");",
      "    }",
      "    ",
      "    if (!this.isValid(value)) {",
      "      throw new ApiError(StatusCodes.BAD_REQUEST, \"Invalid ${1:Name}\");",
      "    }",
      "",
      "    return new ${1:Name}({ value });",
      "  }",
      "}",
    ],
    "description": "Create a value object class",
