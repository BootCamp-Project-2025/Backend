generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course{
   id      String      @id @default(uuid())
  name   String   @unique
  field String
  requirements String
  time Int
  description    String
  imgSrc String
  modules Module[]
}

model Module{
  id      String      @id @default(uuid())
  author   Course @relation(fields: [CourseId], references: [id])
  CourseId String
  name   String   @unique
}

model SampleData {
  id String @id @default(uuid())
  content String
}

enum UserRole {
  CLIENT
  FREELANCER
}

model User {
  id                 String      @id @default(uuid())
  userName           String      @default("")
  userEmail          String      @unique
  roles              UserRole[]  @default([CLIENT])
  createdAt          DateTime    @default(now())
  freelancerProfile  Freelancer? @relation("UserFreelancer") 
  clientProfile      Client?     @relation("UserClient")
}

model Freelancer {
  id      String @id @default(uuid())
  userId  String @unique 
  user    User   @relation("UserFreelancer", fields: [userId], references: [id] , onDelete: Cascade)
  about          String          @default("")
  skills         Skill[]
  languages      Language[]
  education      Education[]
  experience     Experience[]
  certifications Certification[]
}

model Client {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation("UserClient", fields: [userId], references: [id] , onDelete: Cascade)
}

model Skill {
  id           String     @id @default(uuid())
  name         String     @default("")
  level        String     @default("")
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Language {
  id           String     @id @default(uuid())
  name         String     @default("")
  level        String     @default("")
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Certification {
  id            String     @id @default(uuid())
  certification String     @default("")
  institution   String     @default("")
  year          DateTime   @default(now())
  freelancerId  String
  freelancer    Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Education {
  id           String     @id @default(uuid())
  career       String     @default("")
  university   String     @default("")
  startDate    DateTime   @default(now())
  endDate      DateTime   @default(now())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Experience {
  id           String     @id @default(uuid())
  position     String     @default("")
  employer     String     @default("")
  country      String     @default("")
  description  String     @default("")
  startDate    DateTime   @default(now())
  endDate      DateTime   @default(now())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}